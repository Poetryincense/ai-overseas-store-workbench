# ============================================================
# Local Development Infrastructure — EXAMPLE VALUES ONLY
# Copy this file to `.env` and replace with your own values.
# The real `.env` file is git-ignored and must never be committed.
# ============================================================

# --- PostgreSQL (used by the `postgres` Compose service) ---
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=change-me-local-only

# Application connection string (used by apps/api and apps/worker)
DATABASE_URL=postgresql://workbench:change-me-local-only@127.0.0.1:5432/workbench

# --- Redis (used by the `redis` Compose service and apps) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Workbench/API browser origin (exact CORS + CSRF allow-list) ---
WEB_ORIGIN=http://localhost:3000
